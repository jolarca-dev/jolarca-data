# profiles.yml.example — copy to profiles.yml (gitignored) and provide
# values via environment variables (.envrc). NEVER put real credentials
# in this file or commit profiles.yml (ADR-0002).
jol_m_data:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('WH_HOST') }}"
      port: "{{ env_var('WH_PORT') | int }}"
      user: "{{ env_var('WH_USER') }}"
      password: "{{ env_var('WH_PASSWORD') }}"
      dbname: "{{ env_var('WH_DB') }}"
      schema: "{{ env_var('WH_SCHEMA') }}"
      threads: 4
